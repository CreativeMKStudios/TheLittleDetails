---
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { services } from '../../data/services';

const base = import.meta.env.BASE_URL;
const description =
  'Used cars, help finding a car, preparation, and valeting at The Little Details in Sandy. Call to ask what is in.';
---

<Base
  title="Services"
  description={description}
  crumbs={[
    { name: 'Home', path: '' },
    { name: 'Services', path: 'services/' },
  ]}
>
  <header class="page-hero">
    <p class="kicker">Services</p>
    <h1>What the workshop actually does</h1>
    <p>
      Four jobs show up in the company record and in Google reviews. There is no price menu on this site.
    </p>
  </header>
  <div class="section service-list">
    {
      services.map((service) => (
        <article class="service-block">
          <div>
            <p class="kicker">{service.kicker}</p>
            <h2>{service.title}</h2>
          </div>
          <div>
            <p>{service.lede}</p>
            <p>
              <a class="text-link" href={`${base}services/${service.slug}/`}>
                Read about {service.title.toLowerCase()}
              </a>
            </p>
          </div>
        </article>
      ))
    }
    <p class="wrap">
      <a class="btn" href={`${base}contact/`}>
        Call about a car
        <span class="btn-arrow"><Icon name="arrow-right" /></span>
      </a>
    </p>
  </div>
</Base>
