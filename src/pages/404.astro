---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Page not found" description="That page is not on The Little Details website.">
  <header class="page-hero">
    <p class="kicker">404</p>
    <h1>That page is not here</h1>
    <p>
      Try the home page, or call 07968 593591.
    </p>
    <p><a href={base}>Back to the workshop</a></p>
  </header>
</Base>
