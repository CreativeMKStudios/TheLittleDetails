---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import pair from '../assets/fiesta-and-focus.jpg';
import z4 from '../assets/bmw-z4-outside.jpg';
import interior from '../assets/interior-prep.jpg';
import fiat from '../assets/fiat-500-workshop.jpg';
import { business } from '../data/business';
import { faqs } from '../data/faqs';
import { reviews } from '../data/reviews';

const base = import.meta.env.BASE_URL;
const homeReviews = reviews.slice(0, 4);
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};

const description =
  'Used cars prepared in Sandy, Bedfordshire. David Oram works from Unit 2a, Stockton End. Call 07968 593591 to see what is in.';
---

<Base title="The Little Details | Used cars in Sandy" description={description} extraSchema={[faqSchema]}>
  <section class="hero">
    <h1 class="hero-word">
      <span class="hero-kicker">The Little</span>
      Details
      <span class="sr-only">Vehicle Enhancements in Sandy</span>
    </h1>
    <div class="hero-stage">
      <div>
        <p>
          Used cars, checked and cleaned at Unit 2a on Stockton End. Call before you come. The Google listing does not show opening hours.
        </p>
        <div class="actions">
          <a class="btn" href={`tel:${business.phoneTel}`}>
            Call David
            <span class="btn-arrow"><Icon name="arrow-right" /></span>
          </a>
          <a class="text-link" href={`${base}projects/`}>See the work</a>
        </div>
      </div>
      <div class="hero-photo">
        <Image
          src={pair}
          alt="Black Ford Fiesta and red Ford Focus ST parked inside the Sandy workshop."
          widths={[480, 800, 1200]}
          sizes="(min-width: 800px) 58vw, 100vw"
          quality={72}
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="split">
      <div class="frame">
        <Image
          src={z4}
          alt="Blue BMW Z4 parked outside the brick unit on Stockton End."
          widths={[480, 800, 1200]}
          sizes="(min-width: 800px) 50vw, 100vw"
          quality={70}
          format="webp"
        />
      </div>
      <div>
        <p class="kicker">The workshop</p>
        <h2>More than a wash</h2>
        <p>
          This is a used-car workshop in Sandy. David prepares the car, then you come and look at it. Buyers mention straight talk, a deep clean, and a car that is ready to drive away.
        </p>
        <div class="actions">
          <a class="btn" href={`${base}services/`}>
            Services
            <span class="btn-arrow"><Icon name="arrow-right" /></span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="details-title">
    <div class="faq-layout">
      <div>
        <p class="kicker">Questions</p>
        <h2 id="details-title">Explore the details</h2>
        <div class="frame frame-gap">
          <Image
            src={interior}
            alt="Car interior with the carpet lifted during preparation at the workshop."
            widths={[480, 800]}
            sizes="(min-width: 800px) 40vw, 100vw"
            quality={68}
            format="webp"
          />
        </div>
      </div>
      <div>
        {
          faqs.map((faq) => (
            <details>
              <summary>
                {faq.q}
                <Icon name="plus" />
              </summary>
              <p>{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="reviews-title">
    <div class="wrap section-head">
      <p class="kicker">Google reviews</p>
      <h2 id="reviews-title">What customers say</h2>
      <p>
        Google showed {business.rating} from {business.ratingCount} reviews on {business.ratingChecked}. These are short lines from public reviews, not every review on the listing.
      </p>
    </div>
    <div class="review-grid">
      {
        homeReviews.map((review) => (
          <article class="review">
            <div class="stars" aria-label="5 out of 5 on Google">
              <Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" />
            </div>
            <blockquote>
              <p>{review.quote}</p>
            </blockquote>
            <footer>{review.name}, {review.date}</footer>
          </article>
        ))
      }
    </div>
    <div class="wrap section-link">
      <a class="text-link" href={`${base}reviews/`}>All quoted reviews</a>
    </div>
  </section>

  <section class="section">
    <div class="split">
      <div>
        <p class="kicker">Visit</p>
        <h2>Come to Sandy</h2>
        <p>
          {business.street}, {business.locality} {business.postalCode}. Buyers also drive from Biggleswade, Potton, Gamlingay, St Neots, and Bedford.
        </p>
        <div class="actions">
          <a class="btn" href={`${base}contact/`}>
            Contact
            <span class="btn-arrow"><Icon name="arrow-right" /></span>
          </a>
          <a class="text-link" href={`${base}areas/`}>Areas</a>
        </div>
      </div>
      <div class="frame">
        <Image
          src={fiat}
          alt="White Fiat 500 parked inside the workshop."
          widths={[480, 800, 1200]}
          sizes="(min-width: 800px) 50vw, 100vw"
          quality={70}
          format="webp"
        />
      </div>
    </div>
  </section>
</Base>
