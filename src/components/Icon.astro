---
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import caretDown from '@phosphor-icons/core/assets/regular/caret-down.svg?raw';
import car from '@phosphor-icons/core/assets/regular/car.svg?raw';
import list from '@phosphor-icons/core/assets/regular/list.svg?raw';
import mapPin from '@phosphor-icons/core/assets/regular/map-pin.svg?raw';
import phone from '@phosphor-icons/core/assets/regular/phone.svg?raw';
import plus from '@phosphor-icons/core/assets/regular/plus.svg?raw';
import starFill from '@phosphor-icons/core/assets/fill/star-fill.svg?raw';
import wrench from '@phosphor-icons/core/assets/regular/wrench.svg?raw';
import xIcon from '@phosphor-icons/core/assets/regular/x.svg?raw';

const icons = {
  'arrow-right': arrowRight,
  'caret-down': caretDown,
  car,
  list,
  'map-pin': mapPin,
  phone,
  plus,
  star: starFill,
  wrench,
  x: xIcon,
};

interface Props {
  name: keyof typeof icons;
  label?: string;
}

const { name, label } = Astro.props;
---

<span
  class="icon"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={icons[name]}
/>
